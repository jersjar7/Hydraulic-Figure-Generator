{
  "name": "hydraulic-figure-generator",
  "private": true,
  "version": "0.1.0",
  "description": "Report-ready hydraulic figures from SRH-2D and SMS H5 exports.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:contracts": "node --import tsx --test tests/extensionContracts.test.ts",
    "test:ui": "vitest run",
    "test:e2e": "playwright test",
    "fixtures:h5": "tsx scripts/generate-synthetic-h5.ts",
    "fixtures:shapefiles": "tsx scripts/generate-synthetic-shapefile.ts",
    "test:natural": "tsx scripts/test-natural.ts",
    "test:site6": "tsx scripts/test-site6.ts"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "h5wasm": "^0.10.3",
    "lucide-react": "^1.26.0",
    "proj4": "^2.20.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shpjs": "^6.2.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
